# This template is for Chipnet (test coins). Mainnet has its own template: mainnet.env.example, and its own file .env.mainnet.
# One process works on one network. With VAULTBORN_NETWORK=mainnet none of the CHIPNET_ values below may be present.
VAULTBORN_NETWORK=chipnet
HOST=127.0.0.1
PORT=4173
DOMINION_DB=var/dominion.sqlite
DOMINION_LOCAL_DEMO=true
# New quotes default to separate-stake-v2. Set classic-v1 to restore the previous policy for new quotes.
# DOMINION_ALLOCATION_POLICY=separate-stake-v2
# The game automation key may be given inline (CHIPNET_TREASURY_PRIVATE_KEY) or as a file: CHIPNET_TREASURY_KEY_FILE=var/chipnet/game.key
# Council administration is disabled unless a private token of at least 32 characters is configured.
# VAULTBORN_ADMIN_TOKEN=
CHIPNET_GAME=true
# Pairing is available before a treasury key is configured. Disable explicitly for isolated play.
# VAULTBORN_WALLET_CONNECT=false
# Earlier flags, no longer read by the game: the network is chosen by VAULTBORN_NETWORK alone.
# MAINNET_DEMO_SAFE=false
# REAL_MONEY_PVP_DISABLED=true
XO_TEMPLATE_ENABLED=false
CHIPNET_MIN_CONFIRMATIONS=2
# BCHN or a compatible Chipnet Fulcrum endpoint. Optional until sending BCH.
# CHIPNET_RPC_URL=http://127.0.0.1:48332/
# CHIPNET_RPC_USER=
# CHIPNET_RPC_PASSWORD=
# CHIPNET_ELECTRUM_HOST=
# CHIPNET_TREASURY_PUBLIC_KEY=
# CHIPNET_TREASURY_PRIVATE_KEY=
# Supply a native Chipnet CashAddr for automatic external Development allocations,
# or use the three distinct public keys and unique 32-hex ID to derive a 2-of-3 covenant.
# CHIPNET_DEVELOPMENT_ADDRESS=
# CHIPNET_DEVELOPMENT_COUNCIL_KEYS=
# CHIPNET_DEVELOPMENT_COVENANT_ID=
# The ONE developer receiving address. Sponsorship stays closed until it and at least one prize attestor are set.
# (CHIPNET_SPONSOR_DEVELOPMENT_ADDRESS is retired: it must be unset or equal to CHIPNET_DEVELOPMENT_ADDRESS.)
# One to three compressed public keys of independent prize attestors, comma-separated. Their private keys must
# never be on this server: every prize fund award needs all of them plus the automation key.
# CHIPNET_PRIZE_ATTESTOR_KEYS=
# Sub-dust prize shares: carrier (exact 20/10/5/65 through a covenant sweep) or floor (546-satoshi minimum).
# VAULTBORN_PRIZE_DUST=carrier
# VAULTBORN_CARRIER_WAIT_MS=600000
# Personal vault custody: covenant (default) or operator (previous behaviour). Recovery opens after this many days.
# VAULTBORN_VAULT_CUSTODY=covenant
# VAULTBORN_VAULT_RECOVERY_DAYS=7
# Kingdom shares, raid stakes and at-risk funds: covenant (default). "operator" exists only to spend outputs made before the covenants.
# VAULTBORN_KINGDOM_CUSTODY=covenant
# VAULTBORN_KINGDOM_RECOVERY_DAYS=7
# VAULTBORN_CHEST_RECOVERY_DAYS=3
# VAULTBORN_CAPTURE_AGE_BLOCKS=144
# Behind a reverse proxy set this so that rate limits use the client address from X-Forwarded-For.
# DOMINION_TRUST_PROXY=true
# DOMINION_REGISTRATION_RATE=480
# DOMINION_MAX_CITIES=5000
# Several Electrum servers may be listed, comma-separated. With CHIPNET_REQUIRE_WITNESS=true two must agree on each block.
# CHIPNET_REQUIRE_WITNESS=true
# Optional dedicated, separately funded CashTokens issuer.
# CHIPNET_TERRITORY_CATEGORY=
# CHIPNET_TERRITORY_GENESIS=
# CHIPNET_TERRITORY_ISSUER_PUBLIC_KEY=
# CHIPNET_TERRITORY_ISSUER_KEY=
# CHIPNET_TERRITORY_JOURNAL=var/territory-assets.sqlite

# Independently funded immutable political charter category on Chipnet.
# CHIPNET_POLITICS_CATEGORY=
# CHIPNET_POLITICS_GENESIS=
# CHIPNET_POLITICS_ISSUER_PUBLIC_KEY=
# CHIPNET_POLITICS_ISSUER_KEY=
# CHIPNET_POLITICS_JOURNAL=var/political-assets.sqlite
