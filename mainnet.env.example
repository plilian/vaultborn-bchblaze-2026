# VaultBorn on Bitcoin Cash MAINNET: real BCH.
# Copy this file to .env.mainnet, fill it in, keep it out of version control, and start with:  npm run start:mainnet
# Check it first, without sending anything:                                        npm run preflight:mainnet
#
# Nothing in this file may be reused from Chipnet: new keys, new addresses, a new database. The server refuses to start
# if any CHIPNET_ variable is present, if a required value is missing, or until the owner sets the last line.

VAULTBORN_NETWORK=mainnet

# --- Server -------------------------------------------------------------------------------------------------------
HOST=127.0.0.1
PORT=4173
# A database file used for Mainnet only. Back it up (docs/MAINNET.md, "Backups").
DOMINION_DB=var/mainnet/vaultborn.sqlite
# Demo seats must be off: with them any visitor could take over a seeded kingdom.
DOMINION_LOCAL_DEMO=false
# The site is served over TLS by the reverse proxy in infrastructure/mainnet; cookies are then marked Secure.
DOMINION_HTTPS=true
DOMINION_TRUST_PROXY=true
# Optional council administration token, at least 32 random characters.
# VAULTBORN_ADMIN_TOKEN=

# --- Money --------------------------------------------------------------------------------------------------------
MAINNET_GAME=true
# YOUR ONE receiving address for the 20% Development share and 30% of sponsorships. A wallet only you control;
# the game never holds its key. Must start with bitcoincash:
MAINNET_DEVELOPMENT_ADDRESS=
# The game automation key, created on the server with:  node scripts/network-keys.mjs new var/mainnet/game.key
# It can pay a War Chest only to its owner, publish proof records and co-sign what the attestors approved.
# It holds no player or prize money and needs no balance.
MAINNET_TREASURY_KEY_FILE=var/mainnet/game.key
# Two or three compressed public keys of INDEPENDENT attestors, comma-separated (three recommended: any two then sign).
# Each attestor creates their own key on their own machine (docs/ATTESTOR_GUIDE.md). Their private keys never come here.
MAINNET_PRIZE_ATTESTOR_KEYS=
# Who runs the attestors: "independent" (people other than you) or "owner" (you; the game then tells players that they
# are not independent). The launcher sets "owner" and runs three attestors for you.
MAINNET_ATTESTOR_OPERATION=
# Optional: require more than a majority (for example 3 of 3). A smaller number is refused.
# MAINNET_PRIZE_ATTESTOR_THRESHOLD=

# --- Chain observation --------------------------------------------------------------------------------------------
# Recommended: your own Bitcoin Cash Node (txindex=1). The game checks that it holds Bitcoin Cash block 661648.
# MAINNET_RPC_URL=http://127.0.0.1:8332
# MAINNET_RPC_USER=
# MAINNET_RPC_PASSWORD=
# Electrum (Fulcrum) servers, comma-separated host:port (TLS). Leave unset for the built-in list. With no own node,
# a second server must confirm every block (do not set MAINNET_REQUIRE_WITNESS=false).
# MAINNET_ELECTRUM_HOST=
MAINNET_MIN_CONFIRMATIONS=2

# --- Optional: CashTokens proof collectibles (territory deeds, treaty charters) ---------------------------------------
# Off unless configured. Create a category with scripts/token-genesis.mjs after funding the issuer address.
# MAINNET_TERRITORY_CATEGORY=
# MAINNET_TERRITORY_GENESIS=
# MAINNET_TERRITORY_ISSUER_PUBLIC_KEY=
# MAINNET_TERRITORY_ISSUER_KEY_FILE=var/mainnet/issuer.key
# MAINNET_TERRITORY_JOURNAL=var/mainnet/territory-assets.sqlite
# MAINNET_POLITICS_CATEGORY=
# MAINNET_POLITICS_GENESIS=
# MAINNET_POLITICS_ISSUER_PUBLIC_KEY=
# MAINNET_POLITICS_ISSUER_KEY_FILE=var/mainnet/issuer.key
# MAINNET_POLITICS_JOURNAL=var/mainnet/political-assets.sqlite

# --- The owner's authorisation ------------------------------------------------------------------------------------
# Leave this EMPTY until you have decided that real BCH may move. The server refuses to start on Mainnet without it.
# When you authorise the launch, set it to:  real-bch
VAULTBORN_MAINNET_ACK=
